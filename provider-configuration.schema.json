{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omniseed.org/providers/google/configuration-v1.json",
  "title": "Google Provider process configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "apiBase": {
      "type": "string",
      "pattern": "^https://generativelanguage\\.googleapis\\.com(?:/.*)?$"
    },
    "credentialReferenceEnvironment": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]*$" },
      "additionalProperties": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
    },
    "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 60 }
  }
}
